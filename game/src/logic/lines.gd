static func pick(key: String, rng: RandomNumberGenerator = null) -> String:
	var arr: Array = BANK.get(key, [])
	if arr.is_empty():
		return ""
	if rng == null:
		return arr[randi() % arr.size()]
	return arr[rng.randi_range(0, arr.size() - 1)]


static func fmt(key: String, rng: RandomNumberGenerator = null, args := {}) -> String:
	return pick(key, rng).format(args)
