	g.resize(W * H)
	var cmds: Array = ARTS.get(id, ARTS["polevka"])
	for cm in cmds:
		match cm[0]:
			"e":
				for y in H:
					for x in W:
						var dx: float = (x + 0.5 - cm[1]) / cm[3]
						var dy: float = (y + 0.5 - cm[2]) / cm[4]
						if dx * dx + dy * dy <= 1.0:
							_put(g, x, y, cm[5])
			"r":
				for y in range(int(floor(cm[2])), int(ceil(cm[2] + cm[4]))):
					for x in range(int(floor(cm[1])), int(ceil(cm[1] + cm[3]))):
						_put(g, x, y, cm[5])
			"p":
				_put(g, int(cm[1]), int(cm[2]), cm[3])
			"t":
				for y in H:
					for x in W:
						var px := x + 0.5
						var py := y + 0.5
						var a := _edge(cm[1], cm[2], cm[3], cm[4], px, py)
						var b := _edge(cm[3], cm[4], cm[5], cm[6], px, py)
						var d := _edge(cm[5], cm[6], cm[1], cm[2], px, py)
						if (a >= 0 and b >= 0 and d >= 0) or (a <= 0 and b <= 0 and d <= 0):
							_put(g, x, y, cm[7])
			"l":
				var vx: float = cm[3] - cm[1]
				var vy: float = cm[4] - cm[2]
				var len2 := maxf(vx * vx + vy * vy, 0.0001)
				var rr: float = cm[5] / 2.0
				for y in H:
					for x in W:
						var px := x + 0.5
						var py := y + 0.5
						var t := clampf(((px - cm[1]) * vx + (py - cm[2]) * vy) / len2, 0.0, 1.0)
						var ex: float = px - (cm[1] + vx * t)
						var ey: float = py - (cm[2] + vy * t)
						if ex * ex + ey * ey <= rr * rr + 0.05:
							_put(g, x, y, cm[6])
	_cache[id] = g
	return g


static func _edge(ax: float, ay: float, bx: float, by: float, px: float, py: float) -> float:
	return (bx - ax) * (py - ay) - (by - ay) * (px - ax)


static func _put(g: PackedByteArray, x: int, y: int, c: int) -> void:
	if x < 0 or y < 0 or x >= W or y >= H:
		return
	if c == 2:
		c = 1 if ((x + y) & 1) == 1 else 0
	g[y * W + x] = c


## Рисует рисунок в Image (масштаб s, прозрачный фон). clip — [от, до] по колонкам для карт-«франкенштейнов».
static func draw_into(img: Image, id: String, ox: int, oy: int, s: int, clip := Vector2i(0, W)) -> void:
	var g := raster(id)
	for y in H:
		for x in range(clip.x, clip.y):
			var v := g[y * W + x]
			if v == 0:
				continue
			img.fill_rect(Rect2i(ox + x * s, oy + y * s, s, s), BLOOD if v == 3 else INK)


## Рисунок своими цветами (для кадров плёнки — светлая тушь на чёрном, для набросков — карандаш). Кэшируется.
static func tinted(id: String, s: int, ink: Color, accent: Color, hatch := true) -> ImageTexture:
	var key := "%s|%d|%s|%s|%s" % [id, s, ink.to_html(), accent.to_html(), hatch]
	if _tex_cache.has(key):
		return _tex_cache[key]
	var img := Image.create(W * s, H * s, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var g := raster(id)
	for y in H:
		for x in W:
			var v := g[y * W + x]
			if v == 0:
				continue
			img.fill_rect(Rect2i(x * s, y * s, s, s), accent if v == 3 else ink)
	var tex := ImageTexture.create_from_image(img)
	_tex_cache[key] = tex
	return tex


static func make_texture(id: String, s := 4, paper := Color(0, 0, 0, 0)) -> ImageTexture:
	var img := Image.create(W * s, H * s, false, Image.FORMAT_RGBA8)
	img.fill(paper)
	draw_into(img, id, 0, 0, s)
	return ImageTexture.create_from_image(img)
