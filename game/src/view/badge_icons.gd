## Нарисовать значок в Control: pos — левый верхний угол, px — размер «пикселя».
static func draw(ci: CanvasItem, id: String, pos: Vector2, px: float, color: Color) -> void:
	var rows: Array = ICONS.get(id, [])
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			if row[x] == "#":
				ci.draw_rect(Rect2(pos + Vector2(x, y) * px, Vector2(px, px)), color)
